#!/usr/bin/env node
// optiflow-chop CLI entry point. This is the binary the PreToolUse hook
// (src/chop/pretooluse.ts) rewrites eligible Bash commands to invoke
// ("optiflow-chop <original command>"). Requires the esbuild-bundled output
// (src/chop/wrapper.ts -> plugin/dist/chop/wrapper.js) so plugin installs
// never need to run a build — see esbuild.config.mjs, and plugin/bin/optiflow
// for the identical pattern.
import "../dist/chop/wrapper.js";
