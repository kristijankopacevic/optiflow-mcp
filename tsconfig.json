{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "out",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "plugin/dist",
    "vendor",
    "fixtures",
    "src/optimizer/tools/code-analysis/smart-typescript.ts",
    "src/optimizer/tools/dashboard-monitoring/report-generator.ts"
  ]
}
