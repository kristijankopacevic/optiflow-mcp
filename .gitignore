node_modules/
/out/
.optiflow/
*.log

# Rust build artifacts under native/ (multi-GB target/ dirs) — never commit.
native/*/target/

# native/*/pkg/ (wasm-pack's compiled .wasm + JS glue output) IS committed,
# same reasoning as plugin/dist/: src/native/smart-crusher.ts's
# `import ... from "../../native/headroom-wasm/pkg/headroom_wasm.js"` is a
# real runtime dependency, not test-only, and a plugin install never runs
# `cargo`/`wasm-pack` - if this weren't committed, the compression pipeline
# would silently fail to load for anyone who didn't happen to build it
# locally in the exact right place first.
